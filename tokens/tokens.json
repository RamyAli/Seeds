{
  "color": {
    "primary": {
      "seed-orange": { "value": "#DE6538", "rgb": [222, 101, 56], "use": "Logo on Loam, primary buttons, one highlight per layout" },
      "loam": { "value": "#22201E", "rgb": [34, 32, 30], "use": "Main text, dark grounds, packaging, devices" }
    },
    "secondary": {
      "silt": { "value": "#EFEBE3", "use": "Light backgrounds" },
      "clay": { "value": "#A9441D", "use": "Orange text and links on light grounds" },
      "canopy": { "value": "#2E4B33", "use": "Seed Stock packaging, crop content" },
      "shoot": { "value": "#9DBF6A", "use": "Healthy status, small accents on Loam" },
      "husk": { "value": "#D9C9A8", "use": "Kraft paper, secondary panels" }
    },
    "data": {
      "dry": { "value": "#C9A04A", "use": "Reading below target" },
      "optimal": { "value": "#5E8F47", "use": "Reading in range" },
      "wet": { "value": "#3D7A94", "use": "Reading above target" },
      "alert": { "value": "#B8322A", "use": "Act now, device faults" }
    }
  },
  "font": {
    "display": { "family": "Newsreader", "weights": [300, 400], "use": "Headlines, product and variety names" },
    "body": { "family": "Schibsted Grotesk", "weights": [400, 600], "use": "Body copy and interface" },
    "mono": { "family": "IBM Plex Mono", "weights": [400, 500], "use": "Readings, specs, labels" }
  },
  "typeScale": {
    "label": { "size": 12, "lineHeight": 16 },
    "body": { "size": 16, "lineHeight": 26 },
    "lead": { "size": 20, "lineHeight": 30 },
    "h3": { "size": 26, "lineHeight": 34 },
    "h2": { "size": 36, "lineHeight": 43 },
    "h1": { "size": 52, "lineHeight": 57 },
    "display": { "size": 88, "lineHeight": 92 }
  },
  "radius": { "control": 6 },
  "logo": {
    "clearSpace": "1x on every side (x = width of one bracket); 2x on packaging and signage",
    "minimumWidth": { "logo": "120px / 30mm", "mark": "40px / 10mm", "appIcon": "24px" }
  }
}
